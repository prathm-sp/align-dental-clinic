# Environment variables
# Copy this file to `.env.local` for local development.
# Set the same values in Vercel → Project → Settings → Environment Variables for production.

# ─── Required for production ───────────────────────────────────────────────

# Your live website URL (no trailing slash)
# Used for SEO metadata, sitemap, Open Graph links, and JSON-LD schema.
NEXT_PUBLIC_SITE_URL=https://aligndentalclinic.com

# ─── Optional ────────────────────────────────────────────────────────────────

# Google Search Console verification (optional — helps monitor Google search traffic)
# After adding your site in Search Console, choose "HTML tag" verification.
# Paste ONLY the content value from the meta tag.
# Example: GOOGLE_SITE_VERIFICATION=abc123xyz

GOOGLE_SITE_VERIFICATION=
